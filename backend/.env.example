# Copy to .env and fill in. Generate Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENVIRONMENT=development
POSTGRES_USER=replace-with-local-user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=dazu_pos
DATABASE_URL=postgresql+asyncpg://replace-with-local-user:replace-with-local-password@localhost:5432/dazu_pos
REDIS_URL=redis://localhost:6379/0

JWT_ISSUER=dazu-pos
JWT_KID=v1
JWT_STAFF_SECRET=change-me-staff-secret-min-32-chars-long
JWT_ADMIN_SECRET=change-me-admin-secret-min-32-chars-long
JWT_SIGNUP_SECRET=change-me-signup-secret-min-32-chars-long
JWT_RESET_SECRET=change-me-reset-secret-min-32-chars-long
# Optional previous secrets for rotation (same kid namespace, comma-separated kid:secret)
# JWT_STAFF_SECRETS=v1:old-secret,v2:new-secret

PIN_PEPPER=change-me-pin-pepper-min-32-chars-long
OTP_PEPPER=change-me-otp-pepper-min-32-chars-long
MFA_ENCRYPTION_KEY=replace-with-fernet-key

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_MAX_ATTEMPTS=5
OTP_PHONE_HOURLY_LIMIT=3
OTP_IP_HOURLY_LIMIT=20
OTP_GLOBAL_DAILY_LIMIT=10000
SIGNUP_CAPTCHA_THRESHOLD=5
ALLOWED_PHONE_PREFIXES=2547,2541
ADMIN_COOKIE_MODE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=DAZU

# Optional. After repeated signup starts from one IP, Turnstile becomes required.
TURNSTILE_SECRET=

# Argon2id (lower these only in tests)
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2

# Staff PIN login sliding-window limits (per minute)
PIN_LOGIN_IP_LIMIT=60
PIN_LOGIN_DEVICE_LIMIT=30
LOCKOUT_FAILURES=5
LOCKOUT_BASE_SECONDS=900
ADMIN_LOGIN_IP_LIMIT=30
PASSWORD_RESET_PHONE_HOURLY_LIMIT=3
PASSWORD_RESET_IP_HOURLY_LIMIT=20
PASSWORD_RESET_GLOBAL_DAILY_LIMIT=10000
